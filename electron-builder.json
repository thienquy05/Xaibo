{
  "appId": "local.xaibo.app",
  "productName": "Xaibo",
  "electronVersion": "45.2.3",
  "electronDist": "node_modules/electron/dist",
  "directories": { "output": "release" },
  "files": ["package.json", "out/**", "dist/renderer/**", "integrations/**"],
  "extraResources": [
    { "from": ".cache/sea/xaibo-forwarder", "to": "bin/xaibo-forwarder" },
    { "from": "src/forwarder/xaibo-hook", "to": "bin/xaibo-hook" }
  ],
  "npmRebuild": false,
  "mac": { "target": "dir", "identity": "-", "hardenedRuntime": false }
}
