{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/tmp/xaibo-fixture/tools/flow-hook.sh pre" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/tmp/xaibo-fixture/tools/flow-hook.sh stop" }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 30
}
