{
  "schemaVersion": 1,
  "agents": [
    {
      "id": "synthagent",
      "displayName": "Synthetic Agent",
      "detection": {
        "binaries": [
          {
            "id": "main",
            "names": [
              "synthagent"
            ],
            "versionArgs": [
              "--version"
            ]
          }
        ],
        "locations": [
          "~/.local/bin"
        ]
      },
      "profileRoots": [
        {
          "id": "user",
          "base": "home",
          "relative": ".synthagent"
        }
      ],
      "existenceEvidence": [
        {
          "root": "user",
          "path": "config.json",
          "kind": "file"
        }
      ],
      "reportSetup": {
        "root": "user",
        "file": "config.json",
        "ops": [
          {
            "op": "set",
            "pointer": "/xaiboReportHelper",
            "value": {
              "xaibo": "report-helper"
            }
          },
          {
            "op": "set",
            "pointer": "/xaiboProfileKey",
            "value": {
              "xaibo": "profile-key"
            }
          },
          {
            "op": "set",
            "pointer": "/xaiboAgentId",
            "value": {
              "xaibo": "agent-id"
            }
          },
          {
            "op": "set",
            "pointer": "/reportingEnabled",
            "value": {
              "literal": true
            }
          }
        ]
      }
    }
  ],
  "sessionKinds": []
}
