{
  "schemaVersion": 1,
  "agents": [
    {
      "id": "synthagent",
      "displayName": "Synthetic Agent",
      "detection": {
        "binaries": [
          {
            "id": "main",
            "names": [
              "synthagent"
            ],
            "versionArgs": [
              "--version;id"
            ]
          }
        ],
        "locations": [
          "~/.local/bin"
        ]
      },
      "profileRoots": [
        {
          "id": "user",
          "base": "home",
          "relative": ".synthagent"
        }
      ],
      "existenceEvidence": [
        {
          "root": "user",
          "path": "config.json",
          "kind": "file"
        }
      ]
    }
  ],
  "sessionKinds": []
}
