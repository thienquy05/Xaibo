{
  "schemaVersion": 1,
  "agents": [
    {
      "id": "claude",
      "displayName": "Claude Code",
      "detection": {
        "binaries": [{ "id": "main", "names": ["claude"], "versionArgs": ["--version"] }],
        "locations": ["~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin"]
      },
      "profileRoots": [
        { "id": "user", "base": "home", "relative": ".claude", "envOverride": { "name": "CLAUDE_CONFIG_DIR", "mode": "replaces-root" } }
      ],
      "existenceEvidence": [{ "root": "user", "path": "projects", "kind": "directory" }]
    },
    {
      "id": "codex",
      "displayName": "Codex",
      "detection": {
        "binaries": [{ "id": "main", "names": ["codex"], "versionArgs": ["--version"] }],
        "locations": ["/opt/homebrew/bin", "/usr/local/bin"]
      },
      "profileRoots": [
        { "id": "user", "base": "home", "relative": ".codex", "envOverride": { "name": "CODEX_HOME", "mode": "replaces-root" } }
      ],
      "existenceEvidence": [{ "root": "user", "path": "sessions", "kind": "directory" }],
      "hookEvents": [
        { "versions": { "min": "0.160.0", "max": "0.160.0" },
          "events": ["SessionStart", "SessionEnd", "SubagentStart", "SubagentStop", "PreToolUse", "PermissionRequest", "PostToolUse", "PreCompact",
            "PostCompact", "UserPromptSubmit", "Stop", "Interrupt"],
          "evidence": "S5 (Codex 0.160.0 hook set; PRD §5.3); no PreModelRequest/PostModelRequest in this version (EC-53)" }
      ]
    },
    {
      "id": "agy",
      "displayName": "Antigravity CLI",
      "detection": {
        "binaries": [{ "id": "main", "names": ["agy"], "versionArgs": ["--version"] }],
        "locations": ["~/.local/bin"]
      },
      "profileRoots": [{ "id": "user", "base": "home", "relative": ".gemini/antigravity-cli" }],
      "existenceEvidence": [{ "root": "user", "path": "brain", "kind": "directory" }],
      "hookMappings": {
        "evidence": "P2-T00 agy 1.5.6 hook capture (spikes/p2-agy, D-P2-02); permission, input, compaction, subagent and interrupt behaviour unobserved, so unmapped",
        "model": "modelName",
        "rules": [
          { "event": "SessionStart", "map": "session.start" },
          { "event": "PreInvocation", "map": "busy" },
          { "event": "PostInvocation", "map": "activity" },
          { "event": "PreToolUse", "map": "tool.start", "id": "toolCall.id", "tool": "toolCall.name", "args": "toolCall.args" },
          { "event": "PostToolUse", "map": "tool.end", "id": "toolCall.id" },
          { "event": "Stop", "where": { "terminationReason": "NO_TOOL_CALL", "continuationActive": false, "fullyIdle": true, "error": null }, "map": "turn.end" }
        ]
      }
    }
  ],
  "sessionKinds": [
    { "agent": "claude", "id": "cli", "match": { "entrypoint": "cli" }, "badge": "CLI", "interactive": true,
      "resume": { "args": ["--resume", "{id}"] }, "evidence": "S7, Claude Code 2.1.322" },
    { "agent": "claude", "id": "sdk-cli", "match": { "entrypoint": "sdk-cli" }, "badge": "CLI -p", "interactive": false,
      "resume": { "args": ["-p", "--resume", "{id}"], "promptRequired": true }, "evidence": "S7 (claude -p), S9, Claude Code 2.1.322" },
    { "agent": "claude", "id": "claude-vscode", "match": { "entrypoint": "claude-vscode" }, "badge": "VS Code", "interactive": true,
      "resumeDisabled": "VS Code extension resume not verified (S7)", "evidence": "owner audit (S9 T3)" },
    { "agent": "claude", "id": "claude-desktop", "match": { "entrypoint": "claude-desktop" }, "badge": "Desktop", "interactive": true,
      "resumeDisabled": "Desktop resume not verified; view-only (S7)", "evidence": "owner audit (S9 T3)" },
    { "agent": "codex", "id": "cli", "match": { "entrypoint": "cli", "originator": "codex-tui" }, "badge": "CLI", "interactive": true,
      "resume": { "args": ["resume", "{id}"] }, "evidence": "S6, S9, Codex 0.160.0" },
    { "agent": "codex", "id": "exec", "match": { "entrypoint": "exec", "originator": "codex_exec" }, "badge": "exec", "interactive": false,
      "resume": { "args": ["exec", "resume", "{id}"], "promptRequired": true }, "evidence": "S6, S9, Codex 0.160.0" },
    { "agent": "codex", "id": "vscode", "match": { "entrypoint": "vscode", "originator": "codex_vscode" }, "badge": "VS Code", "interactive": true,
      "resumeDisabled": "VS Code extension resume not verified (S6)", "evidence": "owner audit (S9 T3); source vscode alone is any app-server client (S6)" },
    { "agent": "codex", "id": "via-claude", "match": { "originator": "Claude Code" }, "badge": "via Claude Code", "interactive": false,
      "resumeDisabled": "Started by Claude Code (Codex plugin, app-server); resume not verified", "evidence": "S6: rollout originator = app-server clientInfo.name; Codex plugin 1.0.6 source sends \"Claude Code\" (EC-74)" },
    { "agent": "codex", "id": "desktop", "match": { "originator": "codex_work_desktop" }, "badge": "Desktop", "interactive": true,
      "resumeDisabled": "Desktop app resume not verified (S6)", "evidence": "owner audit (S9 T3); source not paired in the audit" },
    { "agent": "agy", "id": "agy", "match": {},
      "resume": { "args": ["--conversation={id}"] }, "evidence": "D-P2-02 (10): printed by agy 1.5.6, verified in print mode; no entry point in transcripts (T00)" }
  ]
}
