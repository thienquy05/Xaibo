{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xaibo:models.schema.json",
  "title": "Xaibo model list and price table (P2-T08, PRD §5.12, FR-51; sourcing OQ-P2-05)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "currency", "prices_as_of", "sources", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "currency": { "const": "USD" },
    "prices_as_of": { "$ref": "#/$defs/date" },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "url", "retrieved"],
        "properties": {
          "id": { "$ref": "#/$defs/refId" },
          "url": { "type": "string", "maxLength": 512, "pattern": "^https://[^\\s]+$" },
          "retrieved": { "$ref": "#/$defs/date" }
        }
      }
    },
    "models": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "refId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rate": { "type": "number", "minimum": 0, "maximum": 100000 },
    "rates": {
      "description": "USD per million tokens. cache_write keys are the provider's cache classes (e.g. 5m/1h, 30m/12h).",
      "type": "object", "additionalProperties": false, "required": ["input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/rate" },
        "output": { "$ref": "#/$defs/rate" },
        "cache_read": { "$ref": "#/$defs/rate" },
        "cache_write": {
          "type": "object", "maxProperties": 8,
          "propertyNames": { "pattern": "^[0-9]{1,3}[mh]$" },
          "additionalProperties": { "$ref": "#/$defs/rate" }
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "display_name", "source", "prices_verified"],
      "properties": {
        "id": { "description": "Exact model id as agents record it; no patterns, no family matching.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "family": { "$ref": "#/$defs/refId" },
        "context_window": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/refId" },
        "prices_verified": { "description": "False until the owner verifies the rates (OQ-P2-05); unverified rates price nothing.", "type": "boolean" },
        "rates": { "$ref": "#/$defs/rates" },
        "tiers": {
          "description": "Higher rates for a request whose prompt (all input tokens) is above the threshold.",
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["above_prompt_tokens", "rates"],
            "properties": { "above_prompt_tokens": { "type": "integer", "minimum": 1 }, "rates": { "$ref": "#/$defs/rates" } }
          }
        }
      }
    }
  }
}
