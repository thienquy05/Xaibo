{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xaibo:agents.catalog.schema.json",
  "title": "Xaibo agent catalog, Phase 1 detection subset (P1-T08; S11 definitions; grows additively at v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agents", "sessionKinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "agents": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/agent" } },
    "sessionKinds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/sessionKind" } }
  },
  "$defs": {
    "sessionKind": {
      "description": "P2-T04: an agent's entry point (Claude entrypoint; Codex session_meta.source as entrypoint + originator) mapped to a badge, an interactive flag and resume args verified in a spike, or a disabled reason. The first kind whose every match field equals the session's value wins; {id} is replaced by a UUID session id. Never executed before Phase 7.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "id", "match", "evidence"],
      "oneOf": [{ "properties": { "resume": true }, "required": ["resume"] }, { "properties": { "resumeDisabled": true }, "required": ["resumeDisabled"] }],
      "properties": {
        "agent": { "$ref": "#/$defs/refId" },
        "id": { "$ref": "#/$defs/refId" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entrypoint": { "type": "string", "minLength": 1, "maxLength": 128 },
            "originator": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "badge": { "$ref": "#/$defs/displayText" },
        "interactive": { "type": "boolean" },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["args"],
          "properties": {
            "args": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^(?:[A-Za-z0-9@%+=:,./_-]|\\{id\\})+$" } },
            "promptRequired": { "type": "boolean" }
          }
        },
        "resumeDisabled": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "refId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "relPath": { "type": "string", "maxLength": 256, "pattern": "^\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*(/\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*)*$" },
    "literalArg": { "type": "string", "pattern": "^[A-Za-z0-9@%+=:,./_-]+$" },
    "displayText": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}$" },
    "fieldPath": {
      "description": "P3-T13a: a dotted path into a hook payload, own properties only; prototype names are never paths.",
      "type": "string",
      "pattern": "^(?!(?:.*\\.)?(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z_][A-Za-z0-9_]{0,63}(?:\\.[A-Za-z_][A-Za-z0-9_]{0,63}){0,3}$"
    },
    "exactVersion": {
      "description": "P6-T01a: one exact agent version, prerelease allowed; never a range.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}(?:-[A-Za-z0-9.-]{1,48})?$"
    },
    "signalPath": {
      "description": "P6-T01a: a dotted path into a projected agent-output record, own properties only; prototype names are never paths.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?!(?:.*\\.)?(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z_][A-Za-z0-9_]{0,63}(?:\\.[A-Za-z_][A-Za-z0-9_]{0,63}){0,7}$"
    },
    "signInRule": {
      "description": "P6-T01a (S-38, FR-54; S14 D-P6-15): one exact-version rule mapping an allowlisted string leaf of already-ingested agent output to a sign-in method. Which paths are eligible is fixed in code (src/service/usage/sign-in.ts), not here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "version", "record", "field", "test", "method"],
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "source": { "enum": ["claude-statusline", "claude-transcript", "codex-rollout", "agy-transcript"] },
        "version": { "$ref": "#/$defs/exactVersion" },
        "record": { "type": "object", "maxProperties": 8, "propertyNames": { "$ref": "#/$defs/signalPath" }, "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } },
        "field": { "$ref": "#/$defs/signalPath" },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oneOf"],
          "properties": { "oneOf": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" } } }
        },
        "method": { "enum": ["subscription", "api-key", "cloud-provider", "gateway", "mixed"] }
      }
    },
    "assurance": { "enum": ["verified", "unverified", "unsupported"] },
    "reportValue": {
      "description": "P6-T09a (D-P6-18, review M1): a reportSetup value: a boolean, number or null literal, or a value Xaibo supplies. No strings, so catalog data never writes a command or a path of its own.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": { "anyOf": [{ "type": "boolean" }, { "type": "number" }, { "type": "null" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["xaibo"], "properties": { "xaibo": { "enum": ["report-helper", "profile-key", "agent-id"] } } }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "detection", "profileRoots"],
      "properties": {
        "id": { "$ref": "#/$defs/refId" },
        "displayName": { "$ref": "#/$defs/displayText" },
        "reportSetup": {
          "description": "P6-T09a (D-P6-12, D-P6-18): data-only setup for a report-v1 agent: set ops on one JSON file under one declared profile root, applied only through the FR-32 engine after a preview, and for an imported entry only with its setup grant. Plain name pointers (no array indexes, escapes or prototype names); never executed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "file", "ops"],
          "properties": {
            "root": { "$ref": "#/$defs/refId" },
            "file": { "type": "string", "maxLength": 256, "pattern": "^\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*(/\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.json$" },
            "ops": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "pointer", "value"],
                "properties": {
                  "op": { "const": "set" },
                  "pointer": { "type": "string", "maxLength": 256, "pattern": "^(?!.*/(?:__proto__|prototype|constructor)(?:/|$))(?:/[A-Za-z_][A-Za-z0-9_.-]{0,63}){1,8}$" },
                  "value": { "$ref": "#/$defs/reportValue" }
                }
              }
            }
          }
        },
        "compatibility": {
          "description": "P6-T08 (EC-79, US-8; D-P6-19): per exact tested release and surface, whether that surface lists the history, resumes it, attaches live, and records ownership (Gate 0 S6/S7). Bundled catalog only; an untested version or surface is unverified. Display data only, never a launch or control permission.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "surface", "visible", "resumable", "attach", "ownership", "evidence"],
            "properties": {
              "version": { "$ref": "#/$defs/version" },
              "surface": { "enum": ["cli", "exec", "app-server", "sdk-cli", "bg", "vscode", "desktop"] },
              "visible": { "$ref": "#/$defs/assurance" },
              "resumable": { "$ref": "#/$defs/assurance" },
              "attach": { "$ref": "#/$defs/assurance" },
              "ownership": { "$ref": "#/$defs/assurance" },
              "note": { "type": "string", "minLength": 1, "maxLength": 96 },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "signInRules": { "description": "P6-T01a: sign-in method rules (bundled catalog only; an imported entry may carry none). The bundled catalog ships none (S14 Pass-narrowed).", "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/signInRule" } },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binaries"],
          "properties": {
            "binaries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "names", "versionArgs"],
                "properties": {
                  "id": { "$ref": "#/$defs/refId" },
                  "names": {
                    "description": "Lowercase command names; shells and command launchers are refused so argv can never become a shell string.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": { "type": "string", "pattern": "^(?!(?:sh|bash|zsh|dash|ash|ksh|mksh|fish|csh|tcsh|busybox|env|nohup|xargs|cmd|powershell|pwsh|osascript)(?:\\.exe)?$)[a-z0-9_][a-z0-9._-]{0,63}$" }
                  },
                  "versionArgs": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/literalArg" } }
                }
              }
            },
            "locations": {
              "description": "Known install directories, searched after the login-shell PATH and before giving up. ~ = user home; no .. segments.",
              "type": "array",
              "maxItems": 16,
              "items": { "type": "string", "maxLength": 256, "pattern": "^~?(/\\.?[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*)+$" }
            }
          }
        },
        "profileRoots": {
          "description": "Root = <home>/<relative>, or the envOverride value itself (replaces-root) or <value>/<relative> (replaces-base).",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "base", "relative"],
            "properties": {
              "id": { "$ref": "#/$defs/refId" },
              "base": { "const": "home" },
              "relative": { "$ref": "#/$defs/relPath" },
              "envOverride": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "mode"],
                "properties": { "name": { "$ref": "#/$defs/envName" }, "mode": { "enum": ["replaces-base", "replaces-root"] } }
              }
            }
          }
        },
        "existenceEvidence": {
          "description": "Files or dirs whose presence is evidence only, never proof of installation or authentication (FR-01).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "path", "kind"],
            "properties": { "root": { "$ref": "#/$defs/refId" }, "path": { "$ref": "#/$defs/relPath" }, "kind": { "enum": ["file", "directory"] } }
          }
        },
        "hookEvents": {
          "description": "P2-T12 (EC-53): hook events verified for an inclusive version range; a version outside every range is unverified.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["versions", "events", "evidence"],
            "properties": {
              "versions": {
                "type": "object", "additionalProperties": false, "required": ["min"],
                "properties": { "min": { "$ref": "#/$defs/version" }, "max": { "$ref": "#/$defs/version" } }
              },
              "events": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]{1,63}$" } },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "connectRoutes": {
          "description": "P6-T03 part 2b (D-2, D-P6-07): the Claude Connect routes qualified for an inclusive version range (max optional = no upper bound); a version outside every range, a prerelease or an unknown version is unverified. Where one version qualifies both, the plugin wins.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "versions", "evidence"],
            "properties": {
              "route": { "enum": ["claude-plugin", "claude-settings-fallback"] },
              "versions": {
                "type": "object", "additionalProperties": false, "required": ["min"],
                "properties": { "min": { "$ref": "#/$defs/version" }, "max": { "$ref": "#/$defs/version" } }
              },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "hookMappings": {
          "description": "P3-T13a (PRD §6.8): hook events to normalized status evidence by exact event name and exact field predicates (null = absent or null). The first matching rule wins; no rule = reduced coverage. Data only, never executed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "rules"],
          "properties": {
            "evidence": { "type": "string", "minLength": 1, "maxLength": 256 },
            "model": { "$ref": "#/$defs/fieldPath" },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event", "map"],
                "properties": {
                  "event": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
                  "where": {
                    "type": "object",
                    "maxProperties": 8,
                    "propertyNames": { "$ref": "#/$defs/fieldPath" },
                    "additionalProperties": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }
                  },
                  "map": { "enum": ["session.start", "session.end", "turn.start", "turn.end", "busy", "activity", "tool.start", "tool.end"] },
                  "id": { "$ref": "#/$defs/fieldPath" },
                  "tool": { "$ref": "#/$defs/fieldPath" },
                  "args": { "$ref": "#/$defs/fieldPath" },
                  "result": { "$ref": "#/$defs/fieldPath" }
                }
              }
            }
          }
        }
      }
    }
  }
}
