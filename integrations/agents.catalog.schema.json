{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xaibo:agents.catalog.schema.json",
  "title": "Xaibo agent catalog, Phase 1 detection subset (P1-T08; S11 definitions; grows additively at v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agents", "sessionKinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "agents": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/agent" } },
    "sessionKinds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/sessionKind" } }
  },
  "$defs": {
    "sessionKind": {
      "description": "P2-T04: an agent's entry point (Claude entrypoint; Codex session_meta.source as entrypoint + originator) mapped to a badge, an interactive flag and resume args verified in a spike, or a disabled reason. The first kind whose every match field equals the session's value wins; {id} is replaced by a UUID session id. Never executed before Phase 7.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "id", "match", "evidence"],
      "oneOf": [{ "properties": { "resume": true }, "required": ["resume"] }, { "properties": { "resumeDisabled": true }, "required": ["resumeDisabled"] }],
      "properties": {
        "agent": { "$ref": "#/$defs/refId" },
        "id": { "$ref": "#/$defs/refId" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entrypoint": { "type": "string", "minLength": 1, "maxLength": 128 },
            "originator": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "badge": { "$ref": "#/$defs/displayText" },
        "interactive": { "type": "boolean" },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["args"],
          "properties": {
            "args": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^(?:[A-Za-z0-9@%+=:,./_-]|\\{id\\})+$" } },
            "promptRequired": { "type": "boolean" }
          }
        },
        "resumeDisabled": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "refId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "relPath": { "type": "string", "maxLength": 256, "pattern": "^\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*(/\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*)*$" },
    "literalArg": { "type": "string", "pattern": "^[A-Za-z0-9@%+=:,./_-]+$" },
    "displayText": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}$" },
    "fieldPath": {
      "description": "P3-T13a: a dotted path into a hook payload, own properties only; prototype names are never paths.",
      "type": "string",
      "pattern": "^(?!(?:.*\\.)?(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z_][A-Za-z0-9_]{0,63}(?:\\.[A-Za-z_][A-Za-z0-9_]{0,63}){0,3}$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "detection", "profileRoots"],
      "properties": {
        "id": { "$ref": "#/$defs/refId" },
        "displayName": { "$ref": "#/$defs/displayText" },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binaries"],
          "properties": {
            "binaries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "names", "versionArgs"],
                "properties": {
                  "id": { "$ref": "#/$defs/refId" },
                  "names": {
                    "description": "Lowercase command names; shells and command launchers are refused so argv can never become a shell string.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": { "type": "string", "pattern": "^(?!(?:sh|bash|zsh|dash|ash|ksh|mksh|fish|csh|tcsh|busybox|env|nohup|xargs|cmd|powershell|pwsh|osascript)(?:\\.exe)?$)[a-z0-9_][a-z0-9._-]{0,63}$" }
                  },
                  "versionArgs": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/literalArg" } }
                }
              }
            },
            "locations": {
              "description": "Known install directories, searched after the login-shell PATH and before giving up. ~ = user home; no .. segments.",
              "type": "array",
              "maxItems": 16,
              "items": { "type": "string", "maxLength": 256, "pattern": "^~?(/\\.?[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*)+$" }
            }
          }
        },
        "profileRoots": {
          "description": "Root = <home>/<relative>, or the envOverride value itself (replaces-root) or <value>/<relative> (replaces-base).",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "base", "relative"],
            "properties": {
              "id": { "$ref": "#/$defs/refId" },
              "base": { "const": "home" },
              "relative": { "$ref": "#/$defs/relPath" },
              "envOverride": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "mode"],
                "properties": { "name": { "$ref": "#/$defs/envName" }, "mode": { "enum": ["replaces-base", "replaces-root"] } }
              }
            }
          }
        },
        "existenceEvidence": {
          "description": "Files or dirs whose presence is evidence only, never proof of installation or authentication (FR-01).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "path", "kind"],
            "properties": { "root": { "$ref": "#/$defs/refId" }, "path": { "$ref": "#/$defs/relPath" }, "kind": { "enum": ["file", "directory"] } }
          }
        },
        "hookEvents": {
          "description": "P2-T12 (EC-53): hook events verified for an inclusive version range; a version outside every range is unverified.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["versions", "events", "evidence"],
            "properties": {
              "versions": {
                "type": "object", "additionalProperties": false, "required": ["min"],
                "properties": { "min": { "$ref": "#/$defs/version" }, "max": { "$ref": "#/$defs/version" } }
              },
              "events": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]{1,63}$" } },
              "evidence": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        "hookMappings": {
          "description": "P3-T13a (PRD §6.8): hook events to normalized status evidence by exact event name and exact field predicates (null = absent or null). The first matching rule wins; no rule = reduced coverage. Data only, never executed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "rules"],
          "properties": {
            "evidence": { "type": "string", "minLength": 1, "maxLength": 256 },
            "model": { "$ref": "#/$defs/fieldPath" },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event", "map"],
                "properties": {
                  "event": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
                  "where": {
                    "type": "object",
                    "maxProperties": 8,
                    "propertyNames": { "$ref": "#/$defs/fieldPath" },
                    "additionalProperties": { "anyOf": [{ "type": "string", "maxLength": 256 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }
                  },
                  "map": { "enum": ["session.start", "session.end", "turn.start", "turn.end", "busy", "activity", "tool.start", "tool.end"] },
                  "id": { "$ref": "#/$defs/fieldPath" },
                  "tool": { "$ref": "#/$defs/fieldPath" },
                  "args": { "$ref": "#/$defs/fieldPath" },
                  "result": { "$ref": "#/$defs/fieldPath" }
                }
              }
            }
          }
        }
      }
    }
  }
}
