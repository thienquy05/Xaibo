{
  "name": "xaibo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/service/store/migrations', 'out/service/store/migrations', { recursive: true })\" && vite build",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron --test \"test/integration/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p spikes",
    "dist:mac": "npm run build && electron_config_cache=\"${electron_config_cache:-$INIT_CWD/.cache/electron}\" ELECTRON_CACHE=\"${ELECTRON_CACHE:-$INIT_CWD/.cache/electron}\" ELECTRON_BUILDER_CACHE=\"${ELECTRON_BUILDER_CACHE:-$INIT_CWD/.cache/electron-builder}\" electron-builder --mac --config electron-builder.json",
    "spike:build": "tsc -p spikes",
    "spike:test": "node --test \"spikes/**/*.test.ts\"",
    "spike:dist:mac": "npm run spike:build && sh spikes/s3/build-sea.sh && electron_config_cache=\"${electron_config_cache:-$INIT_CWD/.cache/electron}\" ELECTRON_CACHE=\"${ELECTRON_CACHE:-$INIT_CWD/.cache/electron}\" ELECTRON_BUILDER_CACHE=\"${ELECTRON_BUILDER_CACHE:-$INIT_CWD/.cache/electron-builder}\" electron-builder --mac dir --config spikes/app/electron-builder.json && codesign --force --deep --sign - dist/spike/mac-arm64/XaiboSpike.app",
    "spike:test:unsandboxed": "node --test --test-concurrency=1 spikes/shared/runner.unsandboxed-test.ts spikes/s3/receiver.unsandboxed-test.ts spikes/s13/tee.unsandboxed-test.ts",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "privacy:scan": "node scripts/privacy-scan.ts",
    "fixtures:lint": "node scripts/fixture-lint.ts",
    "spike:s1": "node spikes/s1/check.ts",
    "spike:s3": "node spikes/s3/dispatch-bench.ts",
    "spike:s12": "node spikes/s12/run.ts",
    "spike:s10": "node spikes/s10/run.ts",
    "spike:s13": "sh spikes/s13/build-sea.sh && node spikes/s13/overhead.ts --runtime sea"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
