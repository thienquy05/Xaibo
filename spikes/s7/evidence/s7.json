  "t4": {
    "prompts": 3,
    "background": {
      "stopFiredWhileSleepRuns": true,
      "hookEventsAfterStop": [
        "UserPromptSubmit",
        "Stop"
      ],
      "secondsFromStopToLastSignal": 29.7,
      "transcriptRecordsAfterStop": [
        "api-request",
        "api-request-blob",
        "assistant",
        "queue-operation",
        "system:stop_hook_summary",
        "system:turn_duration",
        "user"
      ]
    },
    "subagent": {
      "orderedEvents": [
        "SubagentStart",
        "Stop",
        "SubagentStop"
      ],
      "stopFired": true,
      "backgroundedAgentShown": true
    },
    "interrupt": {
      "toolStarted": true,
      "eventsAfterInterruptedPreToolUse": [],
      "stopFired": false,
      "stopFailureFired": false,
      "postToolUseFired": false,
      "postToolUseFailureFired": false,
      "toolResult": {
        "isError": true,
        "rejected": true,
        "interrupted": false
      },
      "note": "events after the interrupted call until the session ended, any source (the backgrounded subagent may add its own)"
    },
    "exitDialogWithBackgroundWork": false
  },
  "s13": {
    "prompts": 3,
    "compact": {
      "preCompactFired": true,
      "postCompactFired": true,
      "postCompactKeys": [
        "compact_summary",
        "cwd",
        "hook_event_name",
        "prompt_id",
        "session_id",
        "transcript_path",
        "trigger"
