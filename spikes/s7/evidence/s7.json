{
  "claude": "2.1.322 (installed version auto-updated from the 2.1.319 pin during Phase 0)",
  "profile": "temp (claude-a), runner, --permission-mode default; /model sonnet in the s13 step persisted to the temp settings, so later steps ran on Sonnet 5.5",
  "t1": {
    "prompts": 5,
    "launch": {
      "syntax": "claude --session-id <uuid> \"<prompt>\"",
      "turnCompleted": true,
      "transcriptAtProjectsEncIdJsonl": true,
      "entrypoint": [
        "cli"
      ]
    },
    "resume": {
      "syntax": "claude --resume <id> [\"<prompt>\"]",
      "turnCompleted": true,
      "sameIdAndFile": true
    },
    "fork": {
      "syntax": "claude --resume <id> --fork-session",
      "turnCompleted": true,
      "newId": true
    },
    "print": {
      "syntax": "claude -p \"<prompt>\"",
      "exit": 0,
      "entrypoint": [
        "sdk-cli"
      ],
      "resumeByIdSyntax": "claude -p --resume <id> \"<prompt>\"",
      "resumeByIdExit": 0,
      "pickerShowsPrintSession": false,
      "pickerSaysNone": true
    },
    "helpLists": [
      "--bg / --background",
      "attach",
      "--desktop",
      "--fork-session",
      "--session-id"
    ]
  },
  "t2": {
    "prompts": 1,
    "deniedWith": "Esc at the permission dialog",
    "orderedEvents": [
      "SessionStart",
      "UserPromptSubmit",
      "PreToolUse",
      "PermissionRequest",
      "SessionEnd"
    ],
    "permissionRequestFired": true,
    "notificationPermissionPrompt": false,
    "permissionDeniedFired": false,
    "postToolUseFired": false,
    "postToolUseFailureFired": false,
    "stopFired": false,
    "permissionRequestKeys": [
      "cwd",
      "effort",
      "hook_event_name",
      "permission_mode",
      "permission_suggestions",
      "prompt_id",
      "session_id",
      "tool_input",
      "tool_name",
      "transcript_path"
    ],
    "preToolUseHasToolUseId": true,
    "permissionRequestHasToolUseId": false,
    "transcript": {
      "isError": true,
      "rejected": true,
      "interrupted": false
    },
    "fileCreated": null,
    "fileCreatedNote": "not measurable: spike.txt was left by the invalid auto-mode attempt in the same directory"
  },
  "t3": {
