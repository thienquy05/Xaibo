        "preTokens",
        "trigger"
      ],
      "captureSequence": [
        "null",
        "usage",
        "null",
        "new-model:null",
        "usage"
      ],
      "captureSequenceNote": "statusLine captures of the session in order, runs collapsed: null = current_usage null; a null run between usage runs of the same model follows /compact"
    },
    "effort": {
      "command": "/effort low",
      "levelBefore": "medium",
      "levelAfter": "low"
    },
    "model": {
      "command": "/model sonnet",
      "idChanged": true,
      "windowSizeChanged": false,
      "currentUsageAfterSwitchVsAfterCompact": "number (was null)"
    }
  },
  "note": "t2/t3 earlier attempts (auto mode; prompt swallowed by list-taking flags) were overwritten by the reruns; 20 prompts attempted in total"
}
