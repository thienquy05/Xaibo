{
  "schemaVersion": 1,
  "id": "synthagent",
  "displayName": "Synthetic Agent",
  "entryVersion": "0.1.0",
  "lifecycle": "experimental",
  "testedVersions": [
    {
      "version": "1.0.0",
      "status": "unverified"
    }
  ],
  "detection": {
    "binaries": [
      {
        "id": "main",
        "names": [
          "synthagent"
        ],
        "versionArgs": [
          "--version"
        ]
      }
    ],
    "locations": [
      "~/.local/bin"
    ]
  },
  "profileRoots": [
    {
      "id": "user",
      "base": "home",
      "relative": ".synthagent",
      "envOverride": {
        "name": "SYNTHAGENT_HOME",
        "mode": "replaces-root"
      }
    }
  ],
  "existenceEvidence": [
    {
      "root": "user",
      "path": "config.json",
      "kind": "file"
    }
  ],
  "adapters": {
    "channels": [
      {
        "kind": "report",
        "version": 1
      }
    ]
  },
  "capabilities": [
    "lifecycle",
    "content",
    "launch",
    "resume"
  ],
  "setupSteps": [
    {
      "kind": "prerequisite",
      "text": "synthagent is installed."
    },
    {
      "kind": "step",
      "text": "Configure synthagent to send report v1 events through the xaibo-report helper."
    }
  ],
  "installHints": [
    {
      "platform": "any",
      "text": "Synthetic agent: no install."
    }
  ],
  "launchTemplates": [
    {
      "purpose": "new",
      "binary": "main",
      "args": []
    },
    {
      "purpose": "resume",
      "binary": "main",
      "args": [
        "resume",
        "{sessionId}"
      ]
    }
  ],
  "envKeyGrants": [
    "SYNTHAGENT_HOME"
  ]
}
