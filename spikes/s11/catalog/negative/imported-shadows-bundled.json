{
  "schemaVersion": 1,
  "id": "gemini",
  "displayName": "Synthetic Negative",
  "entryVersion": "0.1.0",
  "lifecycle": "experimental",
  "testedVersions": [
    {
      "version": "1.0.0",
      "status": "unverified"
    }
  ],
  "detection": {
    "binaries": [
      {
        "id": "main",
        "names": [
          "synthneg"
        ],
        "versionArgs": [
          "--version"
        ]
      }
    ]
  },
  "profileRoots": [
    {
      "id": "user",
      "base": "home",
      "relative": ".synthneg"
    }
  ],
  "adapters": {
    "channels": [
      {
        "kind": "report",
        "version": 1
      }
    ]
  },
  "capabilities": [
    "lifecycle"
  ],
  "launchTemplates": [
    {
      "purpose": "new",
      "binary": "main",
      "args": []
    }
  ]
}
